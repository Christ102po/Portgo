# Railway: set DATABASE_URL to a reference to your MySQL service MYSQL_URL.
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
PORT=4000
NODE_ENV=production
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=8h
SEED_ADMIN_PASSWORD="choose-a-strong-temporary-admin-password"
SEED_ADMIN_EMAIL="admin@portgo.com"

# Your public application URL. Add multiple CORS origins separated by commas only
# if you intentionally host another frontend.
PUBLIC_APP_URL="https://your-portgo-domain.example"
CORS_ORIGIN="https://your-portgo-domain.example"
PORT_NAME="Surigao"

# Live SMS delivery (Semaphore Philippines)
# Required: create a Semaphore account and copy your API key into Railway.
SEMAPHORE_API_KEY=""
# Recommended for Railway: set this to an APPROVED Sender Name from Semaphore.
# It may be omitted only if your Semaphore account already has a registered/default Sender Name.
SEMAPHORE_SENDER_NAME="PORTGO"

# Optional weather integration
OPENWEATHER_API_KEY=""

# Optional SMTP for email verification fallback. If email verification is used, configure a real SMTP provider.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="PORTGO <no-reply@example.com>"
