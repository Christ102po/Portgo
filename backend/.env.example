# Railway: set DATABASE_URL to a reference to your MySQL service MYSQL_URL.
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
PORT=4000
NODE_ENV=production
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=8h
SEED_ADMIN_PASSWORD="choose-a-strong-temporary-admin-password"
SEED_ADMIN_EMAIL="admin@portgo.com"

# Your public application URL. Add multiple CORS origins separated by commas only
# if you intentionally host another frontend.
PUBLIC_APP_URL="https://your-portgo-domain.example"
CORS_ORIGIN="https://your-portgo-domain.example"
PORT_NAME="Surigao"

# Live SMS delivery (Semaphore Philippines)
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME="PORTGO"

# Optional weather integration
OPENWEATHER_API_KEY=""

# ============================================================
# EMAIL OTP
# ============================================================
# auto = Gmail API first, then Resend, then SMTP.
# Railway Free/Trial/Hobby blocks SMTP, so use gmail_api or resend there.
EMAIL_PROVIDER="auto"

# Option A — Gmail API over HTTPS (works on all Railway plans)
# Enable Gmail API in Google Cloud and create OAuth credentials with gmail.send.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_USER="your-email@gmail.com"
MAIL_FROM="PORTGO <your-email@gmail.com>"

# Option B — Resend HTTPS API (also works on all Railway plans)
RESEND_API_KEY=""
# MAIL_FROM="PORTGO <verify@your-verified-domain.com>"

# Option C — SMTP / Gmail SMTP (Railway Pro plan or above only)
# Gmail: use smtp.gmail.com and a Google App Password, NOT your normal password.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
# MAIL_FROM="PORTGO <your-email@gmail.com>"
