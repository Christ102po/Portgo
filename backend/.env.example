# Railway: set DATABASE_URL to a reference to your MySQL service MYSQL_URL.
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
PORT=4000
NODE_ENV=production
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=8h
SEED_ADMIN_PASSWORD="choose-a-strong-temporary-admin-password"

# Your public application URL. Add multiple CORS origins separated by commas only
# if you intentionally host another frontend.
PUBLIC_APP_URL="https://your-portgo-domain.example"
CORS_ORIGIN="https://your-portgo-domain.example"
PORT_NAME="Surigao"

# Phone OTP delivery (OneSignal SMS)
# Find App ID + App API Key in OneSignal Dashboard > Settings > Keys & IDs.
ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""
# Optional. Set only when your OneSignal SMS configuration requires a specific sender.
ONESIGNAL_SMS_FROM=""
# How long a successful phone-verification proof may be used to submit registration.
PHONE_VERIFICATION_TOKEN_TTL="30m"

# Optional weather integration
OPENWEATHER_API_KEY=""

# Optional SMTP for registration confirmation emails.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="PORTGO <no-reply@example.com>"
